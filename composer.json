{
  "name": "voipano/laravel",
  "description": "Official Laravel SDK for the Voipano Public Webservice API v1",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "voipano",
    "laravel",
    "voip",
    "telephony",
    "call",
    "webhook",
    "sdk",
    "iran"
  ],
  "homepage": "https://voipano.com",
  "support": {
    "issues": "https://github.com/voipano/laravel-voipano/issues",
    "source": "https://github.com/voipano/laravel-voipano"
  },
  "require": {
    "php": "^8.2",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Voipano\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Voipano\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Voipano\\Laravel\\VoipanoServiceProvider"
      ],
      "aliases": {
        "Voipano": "Voipano\\Laravel\\Facades\\Voipano"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint": "php -l src/Client.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
